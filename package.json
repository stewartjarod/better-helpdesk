{
  "name": "better-helpdesk",
  "version": "0.6.0",
  "description": "Support inbox, ticketing and lightweight CRM that mounts into a Next.js app, on Postgres, MySQL, SQLite or SQL Server.",
  "keywords": [
    "helpdesk",
    "support",
    "ticketing",
    "shared-inbox",
    "live-chat",
    "chat-widget",
    "customer-support",
    "crm",
    "nextjs",
    "react",
    "web-component",
    "kysely",
    "intercom-alternative",
    "zendesk-alternative"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/better-helpdesk/better-helpdesk.git"
  },
  "homepage": "https://better-helpdesk.com",
  "bugs": {
    "url": "https://github.com/better-helpdesk/better-helpdesk/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./widget": "./src/widget/index.ts",
    "./admin": "./src/admin/index.tsx",
    "./next": "./next.mjs",
    "./rich": "./src/ui/rich.tsx",
    "./adapters": "./src/adapters.ts",
    "./testing": "./src/testing.ts",
    "./relays/wraps": "./src/relays/wraps.ts"
  },
  "bin": {
    "better-helpdesk-import": "bin/import.mjs",
    "better-helpdesk-migrate": "bin/migrate.mjs"
  },
  "files": [
    "dist",
    "migrations",
    "bin",
    "next.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./adapters": {
        "types": "./dist/adapters.d.ts",
        "default": "./dist/adapters.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "./relays/wraps": {
        "types": "./dist/relays/wraps.d.ts",
        "default": "./dist/relays/wraps.js"
      },
      "./widget": {
        "types": "./dist/widget/index.d.ts",
        "default": "./dist/widget/index.js"
      },
      "./admin": {
        "types": "./dist/admin/index.d.ts",
        "default": "./dist/admin/index.js"
      },
      "./next": "./next.mjs",
      "./rich": {
        "types": "./dist/ui/rich.d.ts",
        "default": "./dist/ui/rich.js"
      },
      "./widget.js": "./dist/widget.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "lint": "biome check && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node scripts/test-integration.mjs",
    "migrate": "node bin/migrate.mjs",
    "build:dist": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@testing-library/react": "^16.3.2",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "19.2.7",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "mysql2": "^3.24.5",
    "pg": "^8.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tarn": "^3.1.2",
    "tedious": "^20.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "kysely": "~0.29.6",
    "mailauth": "^7.1.1",
    "mailparser": "^3.9.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "mysql2": "^3.24.0",
    "pg": "^8.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tarn": "^3.0.0",
    "tedious": "^20.0.0",
    "vitest": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "tarn": {
      "optional": true
    },
    "tedious": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.24.0"
}
